<div class="rounded-3 d-flex">
  <div class="d-flex align-items-center me-3">
    <i class="material-icons text-secondary point me-1" data-bs-toggle="modal" data-bs-target="#grid_modal">
      info
    </i>
    <strong class="text-primary fs-5">GRID</strong>
    <i class="material-icons text-primary me-1 fs-5">grid_on</i>
  </div>


  <form id="gridForm" action="/vocab/grid" method="POST" class="menuitem d-flex justify-content-end w-100">
    <input type="hidden" value="" name="deck">
    <input type="hidden" value="" name="deckType">

    <div class="d-flex" style="height:100%;">

      <div class="form-check me-2">
        <input type="hidden" name="showtext" value="false">
        <input id="showtext" type="checkbox" value="true" name="showtext" class="form-check-input">
        <label class="form-check-label small text-center" for="showtext">Text</label>
      </div>

      <div id="numselect" class="form-group mx-2">
        <div class="d-flex rounded-3 border border-secondary">
          <label for="numCards" class="form-label small px-1 mt-1 mb-0">Tiles</label>
          <input id="numCards" type="number" name="spaces" value="25"
            class="form-control form-control-sm border border-top-0 border-bottom-0 border-end-0 border-secondary rounded-3"
            min="4" style="width:3rem;" aria-label="number of squares">
        </div>
      </div>

      <button id="gridButton" type="submit" class="btn btn-sm btn-primary" style="height:100%;">Start</button>
    </div>
  </form>

</div>

