<style>
  .custom-switch {
    position: relative;
    display: inline-block;
    width: 38px;
    height: 22px;
    vertical-align: middle;
  }

  .custom-switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .custom-slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: #0d6efd;
    border-radius: 22px;
    transition: background 0.2s;
  }

  .custom-slider:before {
    position: absolute;
    content: "";
    height: 18px;
    width: 18px;
    left: 2px;
    bottom: 2px;
    background: #fff;
    border-radius: 50%;
    transition: transform 0.2s;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
  }

  .custom-switch input:checked+.custom-slider:before {
    transform: translateX(16px);
  }

  .custom-switch.disabled .custom-slider {
    background: #adb5bd;
    cursor: not-allowed;
  }

  .custom-switch.disabled input {
    pointer-events: none;
  }

  .mode-switch-text {
    font-size: 0.95rem;
    font-weight: 600;
    user-select: none;
    cursor: pointer;
    transition: color 0.15s;
    display: inline-flex;
    align-items: center;
  }

  .mode-switch-text.active {
    color: #0d6efd;
  }

  .mode-switch-text.inactive {
    color: #6c757d;
  }
</style>

<div class="rounded-3 d-flex align-items-center justify-content-between">
  <div class="d-flex align-items-center me-3">
    <i class="material-icons text-secondary point" data-bs-toggle="modal" data-bs-target="#school_modal" style="cursor:pointer;" title="Activity info">
      info
    </i>
    <strong class="text-primary fs-5 ps-2 text-nowrap">SCHOOL DIRECTIONS</strong>
  </div>

  <div class="d-flex align-items-center">
    <!-- Link to Town Directions -->
    <a href="/things/town" class="btn btn-sm btn-outline-secondary py-0 px-2 me-3 d-flex align-items-center" title="Switch to Town Directions">
      <i class="material-icons me-1" style="font-size:16px;">location_city</i>
      <span>Town Map</span>
    </a>

    <!-- Practice / Secret Mode Toggle -->
    <div class="d-flex align-items-center">
      <span class="mode-switch-text active" id="labelPractice" title="Practice Mode">
        <i class="material-icons align-middle">explore</i>
      </span>
      <label class="custom-switch mx-1" id="directionsSwitchLabel" title="Toggle Practice / Secret mode">
        <input type="checkbox" id="directionsModeSwitch" name="mode">
        <span class="custom-slider"></span>
      </label>
      <span class="mode-switch-text inactive" id="labelSecret" title="Secret Mode">
        <i class="material-icons align-middle">help_outline</i>
      </span>
    </div>
  </div>
</div>

<div id="school_modal" class="modal fade">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <strong class="modal-title text-primary fs-5">SCHOOL DIRECTIONS</strong>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p>A school navigation activity for practicing giving and following directions in English inside school buildings.</p>
        <h6>Game Modes:</h6>
        <ul>
          <li><strong>Practice:</strong> All school rooms and facilities are visible. Customise pictures and names.</li>
          <li><strong>Secret:</strong> Locations are hidden behind numbers 1–12. Follow directions to discover them.</li>
        </ul>
        <h6>Voice Commands:</h6>
        <ul>
          <li><em>"Go straight"</em> / <em>"Straight"</em></li>
          <li><em>"Go straight two blocks"</em> / <em>"Go straight three blocks"</em></li>
          <li><em>"Turn left"</em> / <em>"Turn right"</em></li>
          <li><em>"It's on your right"</em> / <em>"It's on your left"</em></li>
          <li><em>"Reset"</em> / <em>"Restart"</em></li>
        </ul>
      </div>
    </div>
  </div>
</div>
