<div class="rounded-3 d-flex">
  <div class="d-flex me-3">
    <i class="material-icons text-secondary point" data-bs-toggle="modal" data-bs-target="#cards_modal">
      info
    </i>
    <strong class="text-primary fs-5">CARDS</strong>
  </div>


  <form id="cardsForm" action="/vocab/printcards" method="POST" class="menuitem d-flex justify-content-end w-100">
    <input type="hidden" value="" name="deck">
    <input type="hidden" value="nolink" name="deckType">

    <div class="d-flex" style="height:100%;">

      <div class="form-group mx-2">
        <div class="d-flex rounded-3 border border-secondary">
          <label for="textsize" class="form-label small px-1 mt-1 mb-0">Text Size</label>
          <input id="textsize" type="number" value="5"
            class="form-control form-control-sm border border-top-0 border-bottom-0 border-end-0 border-secondary rounded-3"
            style="width:3rem;" aria-label="text size in em">
        </div>
      </div>

      <button id="cardsButton" type="submit" class="btn btn-sm btn-primary" style="height:100%;">Start</button>
    </div>
  </form>

</div>

<div id="cards_modal" class="modal fade">
  <div class="modal-dialog">
    <div class="modal-content">

      <div class="modal-header">
        <strong class="modal-title text-primary fs-5">CARDS</strong>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p>This can be used to print flashcards.</p>
      </div>
    </div>
  </div>
</div>


<script>
  $(function () {
    $("#cardsButton").on('click', (e) => {
      e.preventDefault();
      if (!window.deck || window.deck.length == 0) {
        alert("<%- __('pleaseSelect') %>");
      }
      else {
        $.get('/api/any-vocab', { deck: JSON.stringify(window.deck) })
          .then((data) => {
            $("#cardsForm input[name='deck']").val(JSON.stringify(data));
            $("#cardsForm").submit();
          });
      }
    });

    $(`#textsize`).on('change', function () {
      let size = $(this).val();
      if (isNaN(size) || size < 1) {
        size = 5;
        $(this).val(size);
      }
      $('.txt').css('font-size', `${size}em`);
    });
  });
</script>