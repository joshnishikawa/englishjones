<!--
  dictionary.ejs — Inline dictionary partial (included in students/NH.ejs)
  ════════════════════════════════════════════════════════════════════════════
  Features:
    • Text input with debounced translation (500ms) via CDN translate module
    • Speech recognition (Web Speech API) with click-to-speak button & pulse feedback
    • Looks up words in local vocab data from /api/any-vocab
    • Shows word, meaning, image, and native audio pronunciation
-->
<style>
  ::placeholder { text-align:right; }
  .mic-listening {
    animation: mic-pulse 1.5s infinite;
  }
  @keyframes mic-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7);
    }
    70% {
      box-shadow: 0 0 0 10px rgba(220, 53, 69, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(220, 53, 69, 0);
    }
  }
  .play-audio-btn {
    transition: transform 0.15s ease, background-color 0.15s ease;
  }
  .play-audio-btn:hover {
    transform: scale(1.1);
  }
</style>


<div class="container-fluid g-0">

  <div class="row">
<!-- SELECT VOCAB FORMS ------------------------------------------------------->
    <div class="col-4">
      <div class="d-flex mt-1">
        <div class="text-muted">DICTIONARY</div>
        <div class="flex-grow-1"><hr/></div>
      </div>

      <input id="searchInput" name="word" type="text"
              class="form-control my-2" placeholder="日本語 / English" style="text-align:right;" autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false">

      <div class="d-flex justify-content-end align-items-center">
        <div id="speech_label" class="text-muted me-2 small"><%- __('speech') %></div>
        <button id="speech_recognition" type="button" class="btn btn-sm btn-success px-2 py-1" title="Click to speak">
          <i class="material-icons align-middle" style="font-size: 1.1rem;">mic</i>
        </button>
      </div>
    </div>

    <div class="col-8">
      <div id="output"></div>
    </div>


  </div>
</div>


<script type="module">
import translate from "https://cdn.jsdelivr.net/npm/translate/index.min.js";

$(function(){
  let typingTimer;
  const typingDelay = 500; // Delay in milliseconds

  var words = {};
  $.get('/api/any-vocab')
    .done((data) => {
      words = data;
    })
    .fail((xhr, status, error) => {
      console.error("Failed to load vocabulary:", error);
      $("#output").html('<div class="alert alert-danger">Failed to load vocabulary. Please try refreshing the page.</div>');
    });


  function escapeHtml(str) {
    if (str === null || str === undefined) return '';
    var div = document.createElement('div');
    div.appendChild(document.createTextNode(String(str)));
    return div.innerHTML;
  }

  function showWord(w) {
    let safeWord = escapeHtml(w.word);
    let safeMeaning = escapeHtml(w.meaning);
    let audioButton = '';
    if (w.audio) {
      audioButton = `
        <button type="button" class="btn btn-outline-primary btn-sm ms-2 play-audio-btn rounded-circle" data-audio="${escapeHtml(w.audio)}" title="Listen to pronunciation">
          <i class="material-icons align-middle" style="font-size: 20px;">volume_up</i>
        </button>`;
    }

    $("#output").html(
     `<div class="bg-light shadow-sm border rounded-3 p-3 YM d-flex align-items-center justify-content-between">
        <div>
          <div class="d-flex align-items-center">
            <span class="text-primary fs-1 fw-bold">${safeWord}</span>
            ${audioButton}
          </div>
          <span class="fs-3 text-secondary">${safeMeaning}</span>
        </div>
        <div class="text-center ms-3">${w.image || ''}</div>
      </div>`);
  }

  // Audio button click listener
  $(document).on('click', '.play-audio-btn', function(e) {
    e.preventDefault();
    const audioUrl = $(this).data('audio');
    if (audioUrl) {
      const audio = new Audio(audioUrl);
      audio.play().catch(err => {
        console.warn("Audio playback failed:", err);
      });
    }
  });


  // UNIFIED WORD LOOKUP ////////////////////////////////////////////////////////
  async function lookupWord(word) {
    if (!word || !word.trim()) {
      $("#output").html('');
      return;
    }
    word = word.trim();
    $("#output").html('<div class="text-center py-4"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>');

    let EnglishWord = '';
    let JapaneseWord = '';
    let isJapanese = word.match(/[\u3040-\u30ff\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff]/);

    if (isJapanese) {
      JapaneseWord = word;
      try {
        EnglishWord = await translate(word, { from: "ja", to: "en" });
      } catch (error) {
        console.error("Translation error:", error);
        EnglishWord = "Translation failed";
      }
    } else {
      EnglishWord = word;
      let lc = EnglishWord.toLowerCase();
      let matchedVocab = words[EnglishWord] || words[lc];
      if (matchedVocab && matchedVocab.meaning) {
        JapaneseWord = matchedVocab.meaning;
      } else {
        try {
          JapaneseWord = await translate(word, { from: "en", to: "ja" });
        } catch (error) {
          console.error("Translation error:", error);
          JapaneseWord = "Translation failed";
        }
      }
    }

    let image = '';
    let audio = '';
    let displayWord = EnglishWord;
    let displayMeaning = JapaneseWord;

    let lc = EnglishWord.toLowerCase();
    let vocabEntry = words[EnglishWord] || words[lc];

    if (vocabEntry) {
      displayWord = words[EnglishWord] ? EnglishWord : lc;
      if (vocabEntry.image) {
        image = `<img src="${escapeHtml(vocabEntry.image)}" class="img-fluid" style="max-height:150px;" alt="${escapeHtml(displayWord)}">`;
      }
      audio = vocabEntry.audio || '';
      if (vocabEntry.meaning && displayMeaning !== vocabEntry.meaning) {
        if (displayMeaning && displayMeaning !== "Translation failed") {
          displayMeaning += `, ${vocabEntry.meaning}`;
        } else {
          displayMeaning = vocabEntry.meaning;
        }
      }
    }

    showWord({ word: displayWord, meaning: displayMeaning, image, audio });
  }


// TEXT INPUT //////////////////////////////////////////////////////////////////
  $('#searchInput').on('input', function(){
    if (isListening && recognition) {
      try { recognition.stop(); } catch (e) {}
      resetMicUI();
    }
    clearTimeout(typingTimer);
    typingTimer = setTimeout(async () => {
      let word = $(this).val();
      await lookupWord(word);
    }, typingDelay);
  });


// SPEECH RECOGNITION //////////////////////////////////////////////////////////
  new SpeechController({
    toggleBtn: "#speech_recognition",
    toggleIdleClass: "btn-success",
    toggleActiveClass: "btn-danger mic-listening",
    continuous: false,
    interimResults: false,
    maxAlternatives: 3,
    onStatusChange: (status) => {
      if (status === 'listening') {
        $("#speech_recognition").attr("title", "Listening... Click to stop");
        $("#output").html(
          `<div class="bg-light shadow-sm border rounded-3 p-4 text-center">
             <div class="text-danger mb-2">
               <i class="material-icons align-middle fs-1">mic</i>
               <span class="fs-4 ms-2 align-middle fw-bold">Listening...</span>
             </div>
             <div class="text-muted">Speak an English word to look it up in the dictionary</div>
           </div>`
        );
      } else {
        $("#speech_recognition").attr("title", "Click to speak");
      }
    },
    onResult: async (transcript, alternatives, rawAlternatives) => {
      let candidateWord = '';

      for (const raw of rawAlternatives) {
        const cleaned = raw.trim().replace(/[.,?!]/g, '');
        const lc = cleaned.toLowerCase();
        if (words[cleaned] || words[lc]) {
          candidateWord = words[cleaned] ? cleaned : lc;
          break;
        }
      }

      if (!candidateWord && rawAlternatives[0]) {
        candidateWord = rawAlternatives[0].trim().replace(/[.,?!]/g, '');
      }

      if (candidateWord) {
        $('#searchInput').val(candidateWord);
        await lookupWord(candidateWord);
      }
      return true;
    },
    onError: (err) => {
      if (err === 'no-speech') {
        $("#output").html(
          `<div class="alert alert-warning text-center">
             No speech was detected. Please click the mic and try again.
           </div>`
        );
      } else if (err === 'not-allowed' || err === 'service-not-allowed') {
        $("#output").html(
          `<div class="alert alert-danger text-center">
             Microphone permission was denied. Please allow microphone access in your browser.
           </div>`
        );
      } else if (err !== 'aborted') {
        $("#output").html(
          `<div class="alert alert-secondary text-center">
             Speech error: ${escapeHtml(err)}
           </div>`
        );
      }
    }
  });

});
</script>