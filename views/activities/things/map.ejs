<%- include('../../head') %>

<style>
  html, body {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow-x: hidden !important;
    overflow-y: auto !important;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  .mic-listening {
    animation: mic-pulse 1.5s infinite;
    box-shadow: 0 0 0 0 rgba(40, 167, 69, 0.7);
  }
  @keyframes mic-pulse {
    0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(40, 167, 69, 0.7); }
    70% { transform: scale(1.05); box-shadow: 0 0 0 15px rgba(40, 167, 69, 0); }
    100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(40, 167, 69, 0); }
  }

  /* Full Screen Flex Layout below header - 100vh alone */
  .app-layout {
    display: flex;
    height: 100vh;
    min-height: 100vh;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    gap: 8px;
    position: relative;
    box-sizing: border-box;
  }

  /* Side Controls Panel: No background, no border, compact & narrow */
  .side-controls {
    width: 105px;
    min-width: 105px;
    height: 100%;
    background: transparent;
    border: none;
    box-shadow: none;
    display: flex;
    flex-direction: column;
    padding: 0 0 0 8px;
    gap: 6px;
    box-sizing: border-box;
    overflow-y: auto;
    z-index: 30;
  }

  .side-controls .btn {
    font-size: 0.75rem;
    padding: 3px 4px;
    white-space: nowrap;
  }

  /* Main Max-Area Playfield with bottom margin so mover is not cut off */
  .main-play-area {
    flex: 1;
    min-width: 0;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 8px 50px 0;
    box-sizing: border-box;
    overflow: hidden;
  }

  /* Map Board Container taking 100vh */
  .map-board {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 0;
    background: transparent;
    border: none;
    box-shadow: none;
    box-sizing: border-box;
  }

  /* 4x3 Rooms Grid with asphalt street gaps between blocks */
  .rooms-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(3, minmax(0, 1fr));
    gap: 20px;
    width: 100%;
    min-width: 0;
    flex: 1;
    min-height: 0;
    background-color: #334155;
    padding: 0;
    border: none;
    border-radius: 8px;
    box-sizing: border-box;
    position: relative;
    z-index: 6;
  }

  /* Bottom Street matching 20px width of other streets */
  .bottom-street {
    height: 20px;
    min-height: 20px;
    width: 100%;
    background-color: #334155;
    border-radius: 4px;
    box-sizing: border-box;
    position: relative;
    z-index: 6;
  }

  .room-box {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: #ffffff;
    border: 3px solid #cbd5e1;
    border-radius: 8px;
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.15);
    padding: 4px;
    perspective: 800px;
    cursor: pointer;
    transition: background-color 0.2s, box-shadow 0.2s, border-color 0.2s;
    box-sizing: border-box;
    overflow: hidden;
    z-index: 9;
  }

  .room-box.drag-over {
    outline: 3px dashed #2563eb !important;
    background-color: #eff6ff !important;
  }

  .room-inner {
    position: relative;
    width: 100%;
    height: 100%;
    text-align: center;
    transition: transform 0.6s;
    transform-style: preserve-3d;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .room-box.is-flipped .room-inner {
    transform: rotateY(180deg);
  }

  .room-box.highlight {
    background-color: #fef08a !important;
    transition: background-color 0.3s;
  }

  .room-front, .room-back {
    position: absolute;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4px;
    overflow: hidden;
    box-sizing: border-box;
  }

  .room-back {
    transform: rotateY(180deg);
  }

  .room-img {
    max-height: 72%;
    max-width: 85%;
    object-fit: contain;
    cursor: pointer;
    transition: transform 0.15s ease;
  }
  .room-img:hover {
    transform: scale(1.05);
  }

  .room-label {
    font-size: clamp(0.75rem, 1.8vh, 1.15rem);
    font-weight: 700;
    color: #1e293b;
    margin-top: 4px;
    padding: 1px 6px;
    border-radius: 4px;
    outline: none;
    border: 1px solid transparent;
    cursor: text;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 95%;
    transition: background-color 0.15s, border-color 0.15s;
  }
  .room-label:hover {
    background-color: #f1f5f9;
    border-color: #cbd5e1;
  }
  .room-label:focus {
    background-color: #ffffff;
    border-color: #3b82f6;
    box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
  }

  /* Upload button on card hover */
  .img-upload-btn {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.45);
    color: #fff;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.15s, background 0.15s;
    z-index: 10;
    cursor: pointer;
    padding: 0;
  }
  .room-box:hover .img-upload-btn {
    opacity: 1;
  }
  .img-upload-btn:hover {
    background: #2563eb;
  }

  .secret-number {
    font-size: clamp(2rem, 7vh, 4.5rem);
    font-weight: 800;
    color: #2563eb;
  }

  /* Mover Avatar */
  .mover-avatar {
    position: absolute;
    width: 90px;
    height: 90px;
    transform: translate(-50%, -50%);
    transition: left 0.35s ease-in-out, top 0.35s ease-in-out;
    pointer-events: none;
    z-index: 20;
  }

  .mover-avatar img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.2s ease-out;
  }
</style>

<!-- Top Bar with same layout and style as other activity pages -->
<div class="d-flex justify-content-between mb-2">
  <div class="d-flex align-items-center me-3">
    <strong class="text-primary fs-5 ps-2">GETTING AROUND</strong>
  </div>
  <button id="home" class="btn btn-sm btn-outline-secondary p-0 me-2" onclick="location.href='/'" aria-label="Home">
    <i class="material-icons">home</i>
  </button>
</div>

<div class="app-layout pt-1" id="appLayout">
  <!-- Side Controls Panel without background or border, with smaller buttons -->
  <aside class="side-controls">
    <!-- Voice Control Section -->
    <div class="d-grid gap-1">
      <button id="listen" class="btn btn-sm btn-success d-flex align-items-center justify-content-center">
        <i class="material-icons me-1" style="font-size:15px;">record_voice_over</i>
        <span>Start Voice</span>
      </button>
      <button id="stop" class="btn btn-sm btn-secondary d-flex align-items-center justify-content-center" disabled>
        <i class="material-icons me-1" style="font-size:15px;">stop</i>
        <span>Stop Voice</span>
      </button>
    </div>

    <div id="speechTranscript" class="text-muted small fw-bold text-center px-1" style="min-height: 24px; font-size: 0.72rem; line-height: 1.2;">
      Voice ready
    </div>

    <!-- Game Modes -->
    <div class="btn-group-vertical w-100" role="group">
      <button id="modePractice" class="btn btn-sm btn-primary text-start">
        <i class="material-icons align-middle me-1" style="font-size:15px;">explore</i>Practice
      </button>
      <button id="modeTreasure" class="btn btn-sm btn-outline-primary text-start">
        <i class="material-icons align-middle me-1" style="font-size:15px;">star</i>Treasure
      </button>
      <button id="modeSecret" class="btn btn-sm btn-outline-primary text-start">
        <i class="material-icons align-middle me-1" style="font-size:15px;">help_outline</i>Secret
      </button>
    </div>

    <!-- Actions -->
    <button id="resetBtn" class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center">
      <i class="material-icons me-1" style="font-size:15px;">restart_alt</i>
      <span>Restart</span>
    </button>

    <div id="unsupportedAlert" class="alert alert-warning text-center py-1 px-1 small mt-auto mb-0" style="font-size:0.7rem; display:none;">
      Speech recognition not supported.
    </div>
  </aside>

  <!-- SVG Street Markings Layer (Dashed yellow centerlines) -->
  <svg id="streetLinesSvg" style="position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 8;">
    <!-- Vertical street centerlines -->
    <line id="vLine1" stroke="#facc15" stroke-width="2.5" stroke-dasharray="8 6" stroke-linecap="round" />
    <line id="vLine2" stroke="#facc15" stroke-width="2.5" stroke-dasharray="8 6" stroke-linecap="round" />
    <line id="vLine3" stroke="#facc15" stroke-width="2.5" stroke-dasharray="8 6" stroke-linecap="round" />
    <!-- Horizontal street centerlines -->
    <line id="hLine1" stroke="#facc15" stroke-width="2.5" stroke-dasharray="8 6" stroke-linecap="round" />
    <line id="hLine2" stroke="#facc15" stroke-width="2.5" stroke-dasharray="8 6" stroke-linecap="round" />
    <line id="hLine3" stroke="#facc15" stroke-width="2.5" stroke-dasharray="8 6" stroke-linecap="round" />
  </svg>

  <!-- Maximum Area Playfield taking 100% view height -->
  <main class="main-play-area">
    <div class="map-board" id="mapBoard">
      <div class="rooms-grid" id="roomsGrid">
        <!-- 12 Rooms generated dynamically -->
      </div>
      <div class="bottom-street" id="bottomStreet"></div>
    </div>
  </main>

  <!-- Mover Character (positioned across app-layout) -->
  <div id="moverAvatar" class="mover-avatar">
    <img id="moverImg" src="" alt="mover">
  </div>
</div>

<script>
(function() {
  'use strict';

  /* ==========================================================================
     1. DEFAULT ILLUSTRATIONS & MOVER
     ========================================================================== */
  function svgIcon(name, color, bg) {
    const icons = {
      school: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" rx="12" fill="${bg}"/><path d="M50 18 L18 36 L82 36 Z" fill="${color}"/><rect x="26" y="36" width="48" height="42" fill="#fff"/><rect x="42" y="54" width="16" height="24" fill="${color}"/><circle cx="50" cy="28" r="4" fill="#facc15"/></svg>`,
      park: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" rx="12" fill="${bg}"/><circle cx="36" cy="42" r="20" fill="#22c55e"/><circle cx="64" cy="46" r="16" fill="#16a34a"/><rect x="33" y="56" width="6" height="22" fill="#78350f"/><rect x="61" y="58" width="6" height="20" fill="#78350f"/><rect x="22" y="75" width="56" height="6" rx="2" fill="#ca8a04"/></svg>`,
      hospital: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" rx="12" fill="${bg}"/><rect x="22" y="24" width="56" height="58" rx="4" fill="#fff"/><path d="M44 38 h12 v10 h10 v12 h-10 v10 h-12 v-10 h-10 v-12 h10 Z" fill="#ef4444"/></svg>`,
      library: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" rx="12" fill="${bg}"/><path d="M50 18 L15 32 L85 32 Z" fill="#e2e8f0"/><rect x="24" y="32" width="8" height="42" fill="#fff"/><rect x="40" y="32" width="8" height="42" fill="#fff"/><rect x="56" y="32" width="8" height="42" fill="#fff"/><rect x="72" y="32" width="8" height="42" fill="#fff"/><rect x="18" y="74" width="64" height="8" fill="#e2e8f0"/></svg>`,
      supermarket: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" rx="12" fill="${bg}"/><path d="M18 36 L82 36 L72 74 L28 74 Z" fill="#fff"/><circle cx="36" cy="80" r="5" fill="#334155"/><circle cx="64" cy="80" r="5" fill="#334155"/><rect x="36" y="46" width="28" height="18" fill="${color}"/></svg>`,
      police: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" rx="12" fill="${bg}"/><rect x="24" y="32" width="52" height="52" rx="4" fill="#1e3a8a"/><path d="M50 18 L70 32 L30 32 Z" fill="#3b82f6"/><path d="M50 42 L60 48 L56 60 L50 66 L44 60 L40 48 Z" fill="#facc15"/></svg>`,
      fire: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" rx="12" fill="${bg}"/><rect x="24" y="32" width="52" height="52" rx="4" fill="#dc2626"/><circle cx="50" cy="24" r="7" fill="#facc15"/><rect x="42" y="52" width="16" height="24" fill="#fef08a"/></svg>`,
      bakery: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" rx="12" fill="${bg}"/><path d="M26 44 Q50 20 74 44 L70 74 L30 74 Z" fill="#fde047"/><ellipse cx="50" cy="40" rx="18" ry="8" fill="#f59e0b"/><rect x="44" y="56" width="12" height="18" fill="#78350f"/></svg>`,
      station: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" rx="12" fill="${bg}"/><rect x="22" y="26" width="56" height="48" rx="8" fill="#0284c7"/><circle cx="34" cy="62" r="6" fill="#fff"/><circle cx="66" cy="62" r="6" fill="#fff"/><line x1="12" y1="80" x2="88" y2="80" stroke="#64748b" stroke-width="4"/></svg>`,
      zoo: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" rx="12" fill="${bg}"/><circle cx="50" cy="45" r="22" fill="#f59e0b"/><circle cx="34" cy="30" r="7" fill="#d97706"/><circle cx="66" cy="30" r="7" fill="#d97706"/><circle cx="44" cy="42" r="3" fill="#000"/><circle cx="56" cy="42" r="3" fill="#000"/></svg>`,
      playground: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" rx="12" fill="${bg}"/><path d="M22 75 L36 28 L44 28 L74 75" stroke="#ef4444" stroke-width="5" fill="none"/><line x1="30" y1="52" x2="62" y2="52" stroke="#facc15" stroke-width="4"/></svg>`,
      museum: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" rx="12" fill="${bg}"/><path d="M50 16 L20 32 L80 32 Z" fill="#a855f7"/><rect x="26" y="32" width="6" height="44" fill="#fff"/><rect x="42" y="32" width="6" height="44" fill="#fff"/><rect x="52" y="32" width="6" height="44" fill="#fff"/><rect x="68" y="32" width="6" height="44" fill="#fff"/><rect x="18" y="76" width="64" height="6" fill="#cbd5e1"/></svg>`,
      treasure: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><polygon points="50,8 62,36 93,37 68,57 77,88 50,70 23,88 32,57 7,37 38,36" fill="#facc15" stroke="#eab308" stroke-width="4" stroke-linejoin="round"/></svg>`
    };
    return "data:image/svg+xml;charset=utf-8," + encodeURIComponent(icons[name] || icons.school);
  }

  const DEFAULT_PLACES = [
    { id: 0, name: "School", image: svgIcon("school", "#2563eb", "#dbeafe") },
    { id: 1, name: "Park", image: svgIcon("park", "#16a34a", "#dcfce7") },
    { id: 2, name: "Hospital", image: svgIcon("hospital", "#dc2626", "#fee2e2") },
    { id: 3, name: "Library", image: svgIcon("library", "#0891b2", "#cffafe") },
    { id: 4, name: "Supermarket", image: svgIcon("supermarket", "#ea580c", "#ffedd5") },
    { id: 5, name: "Police Station", image: svgIcon("police", "#1d4ed8", "#dbeafe") },
    { id: 6, name: "Fire Station", image: svgIcon("fire", "#e11d48", "#ffe4e6") },
    { id: 7, name: "Bakery", image: svgIcon("bakery", "#d97706", "#fef3c7") },
    { id: 8, name: "Station", image: svgIcon("station", "#0284c7", "#e0f2fe") },
    { id: 9, name: "Zoo", image: svgIcon("zoo", "#ca8a04", "#fef9c3") },
    { id: 10, name: "Playground", image: svgIcon("playground", "#7c3aed", "#ede9fe") },
    { id: 11, name: "Museum", image: svgIcon("museum", "#9333ea", "#f3e8ff") }
  ];

  // Top-down view of person walking (seen from above)
  function createTopDownPerson(stepRight) {
    const leftFootY = stepRight ? 44 : 22;
    const rightFootY = stepRight ? 22 : 44;
    const leftHandY = stepRight ? 41 : 23;
    const rightHandY = stepRight ? 23 : 41;
    return "data:image/svg+xml;charset=utf-8," + encodeURIComponent(`
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
  <!-- Shoes (solid dark sneakers, viewed from above) -->
  <ellipse cx="22" cy="${leftFootY}" rx="4.5" ry="8" fill="#1e293b"/>
  <ellipse cx="42" cy="${rightFootY}" rx="4.5" ry="8" fill="#1e293b"/>

  <!-- Hands / Arms swinging -->
  <circle cx="12" cy="${leftHandY}" r="4" fill="#fed7aa"/>
  <circle cx="52" cy="${rightHandY}" r="4" fill="#fed7aa"/>

  <!-- Torso (Blue shirt from above) -->
  <ellipse cx="32" cy="34" rx="18" ry="10.5" fill="#0284c7"/>
  <ellipse cx="32" cy="31" rx="6" ry="3.5" fill="#fed7aa"/>

  <!-- Hair peaking out at back/sides -->
  <ellipse cx="32" cy="31" rx="11" ry="10" fill="#78350f"/>
  <circle cx="20" cy="31" r="2.5" fill="#fed7aa"/>
  <circle cx="44" cy="31" r="2.5" fill="#fed7aa"/>

  <!-- Baseball Cap Visor / Bill (pointing forward/UP, clearly showing facing direction) -->
  <path d="M 23 27 C 23 8, 41 8, 41 27 C 36 24, 28 24, 23 27 Z" fill="#b91c1c"/>
  <path d="M 24 23 C 25 13, 39 13, 40 23" stroke="#fca5a5" stroke-width="1" fill="none"/>
  <path d="M 25 19 C 26 13, 38 13, 39 19" stroke="#fca5a5" stroke-width="0.75" fill="none" opacity="0.6"/>

  <!-- Cap Crown (Red baseball cap) -->
  <ellipse cx="32" cy="30" rx="10" ry="9" fill="#dc2626"/>

  <!-- Subtle panel seams -->
  <line x1="32" y1="21" x2="32" y2="30" stroke="#7f1d1d" stroke-width="0.8" opacity="0.4"/>
  <line x1="32" y1="30" x2="32" y2="39" stroke="#7f1d1d" stroke-width="0.8" opacity="0.4"/>
  <line x1="32" y1="30" x2="22" y2="30" stroke="#7f1d1d" stroke-width="0.8" opacity="0.4"/>
  <line x1="32" y1="30" x2="42" y2="30" stroke="#7f1d1d" stroke-width="0.8" opacity="0.4"/>

  <!-- Cap Top Button (Squatchee) -->
  <circle cx="32" cy="30" r="1.8" fill="#7f1d1d"/>
</svg>`);
  }

  const personSvg1 = createTopDownPerson(false);
  const personSvg2 = createTopDownPerson(true);
  let stepToggle = false;

  /* ==========================================================================
     2. INDEXEDDB LOCAL PERSISTENCE (Zero Server Upload)
     ========================================================================== */
  const DB_NAME = "GettingAroundDB";
  const DB_VERSION = 1;
  const STORE_PLACES = "places";

  const MapStorage = {
    db: null,
    async init() {
      return new Promise((resolve) => {
        if (!window.indexedDB) return resolve();
        const req = indexedDB.open(DB_NAME, DB_VERSION);
        req.onupgradeneeded = (e) => {
          const db = e.target.result;
          if (!db.objectStoreNames.contains(STORE_PLACES)) {
            db.createObjectStore(STORE_PLACES, { keyPath: "id" });
          }
        };
        req.onsuccess = (e) => {
          this.db = e.target.result;
          resolve();
        };
        req.onerror = () => resolve();
      });
    },

    async savePlace(place) {
      if (this.db) {
        return new Promise((resolve) => {
          try {
            const tx = this.db.transaction(STORE_PLACES, "readwrite");
            tx.objectStore(STORE_PLACES).put(place);
            tx.oncomplete = () => resolve();
            tx.onerror = () => resolve();
          } catch(e) { resolve(); }
        });
      }
      try { localStorage.setItem("map_place_" + place.id, JSON.stringify(place)); } catch(e) {}
    },

    async getAllPlaces() {
      if (this.db) {
        return new Promise((resolve) => {
          try {
            const tx = this.db.transaction(STORE_PLACES, "readonly");
            const req = tx.objectStore(STORE_PLACES).getAll();
            req.onsuccess = () => resolve(req.result || []);
            req.onerror = () => resolve([]);
          } catch(e) { resolve([]); }
        });
      }
      const list = [];
      for (let i = 0; i < 12; i++) {
        try {
          const item = localStorage.getItem("map_place_" + i);
          if (item) list.push(JSON.parse(item));
        } catch(e) {}
      }
      return list;
    }
  };

  function compressImage(file) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          const maxDim = 400;
          let { width, height } = img;
          if (width > maxDim || height > maxDim) {
            if (width > height) {
              height = Math.round((height * maxDim) / width);
              width = maxDim;
            } else {
              width = Math.round((width * maxDim) / height);
              height = maxDim;
            }
          }
          const canvas = document.createElement("canvas");
          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext("2d");
          ctx.drawImage(img, 0, 0, width, height);
          resolve(canvas.toDataURL("image/jpeg", 0.85));
        };
        img.onerror = reject;
        img.src = e.target.result;
      };
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  /* ==========================================================================
     3. GAME STATE & 7x6 GRID NAVIGATION
     ========================================================================== */
  let places = JSON.parse(JSON.stringify(DEFAULT_PLACES));
  let currentMode = "practice"; // 'practice' | 'treasure' | 'secret'
  let treasureIndex = -1;
  let revealedSecrets = new Set();

  // Mover position (38 = starting space under reset button on left)
  let moverPosition = 38;
  let moverAngle = 90; // Cumulative angle in degrees (0 = north, 90 = east, 180 = south, 270 = west)

  function getMoverDir() {
    const norm = ((moverAngle % 360) + 360) % 360;
    if (norm === 0) return "north";
    if (norm === 90) return "east";
    if (norm === 180) return "south";
    if (norm === 270) return "west";
    return "north";
  }

  // Entry door cells on the streets
  const entryObj = {
    0: 0,  2: 1,  4: 2,  6: 3,
    14: 4, 16: 5, 18: 6, 20: 7,
    28: 8, 30: 9, 32: 10, 34: 11
  };

  // Navigable cells
  const canMoveCells = new Set([
    0,1,2,3,4,5,6,
    8,10,12,
    14,15,16,17,18,19,20,
    22,24,26,
    28,29,30,31,32,33,34,
    38
  ]);

  function speak(text) {
    if (!window.speechSynthesis) return;
    try {
      window.speechSynthesis.cancel();
      const u = new SpeechSynthesisUtterance(text);
      u.lang = "en-US";
      window.speechSynthesis.speak(u);
    } catch(e) {}
  }

  /* ==========================================================================
     4. BOARD RENDERING & POSITIONING (Direct Editing & Drag-and-Drop)
     ========================================================================== */
  const roomsGridEl = document.getElementById("roomsGrid");
  const moverAvatarEl = document.getElementById("moverAvatar");
  const moverImgEl = document.getElementById("moverImg");

  moverImgEl.src = personSvg1;

  function renderRooms() {
    roomsGridEl.innerHTML = "";
    places.forEach((place, index) => {
      const box = document.createElement("div");
      box.className = "room-box";
      box.id = `room_${index}`;
      box.dataset.index = index;

      let front = "";
      let back = "";

      if (currentMode === "secret") {
        const isRev = revealedSecrets.has(index);
        front = `
          <div class="secret-number">${index + 1}</div>
          <div class="room-label" data-index="${index}">${place.name}</div>
        `;
        back = `
          <img src="${place.image}" alt="${place.name}" class="room-img" data-index="${index}">
          <div class="room-label" contenteditable="true" spellcheck="false" data-index="${index}">${place.name}</div>
        `;
        if (isRev) box.classList.add("is-flipped");
      } else if (currentMode === "treasure") {
        front = `
          <div class="fs-1">❓</div>
          <div class="room-label">?</div>
        `;
        if (index === treasureIndex) {
          back = `
            <img src="${svgIcon('treasure')}" alt="Gold Star" style="max-height: 60%; max-width: 60%; object-fit: contain;">
            <div class="room-label text-warning fw-bold">Star!</div>
          `;
        } else {
          back = `
            <img src="${place.image}" alt="${place.name}" class="room-img" data-index="${index}">
            <div class="room-label" data-index="${index}">${place.name}</div>
          `;
        }
      } else {
        // Practice Mode: Editable text & direct image change
        front = `
          <img src="${place.image}" alt="${place.name}" class="room-img" data-index="${index}" title="Click or drop an image to change">
          <div class="room-label" contenteditable="true" spellcheck="false" data-index="${index}" title="Click to edit name">${place.name}</div>
        `;
        back = front;
      }

      box.innerHTML = `
        <input type="file" class="room-file-input" data-index="${index}" accept="image/*" style="display:none;">
        <button class="img-upload-btn" data-index="${index}" title="Change picture">
          <i class="material-icons" style="font-size:15px;line-height:24px;">photo_camera</i>
        </button>
        <div class="room-inner">
          <div class="room-front">${front}</div>
          <div class="room-back">${back}</div>
        </div>
      `;

      // 1. Drag and Drop on card
      box.addEventListener("dragover", (e) => {
        e.preventDefault();
        e.stopPropagation();
        box.classList.add("drag-over");
      });

      box.addEventListener("dragleave", (e) => {
        e.preventDefault();
        e.stopPropagation();
        box.classList.remove("drag-over");
      });

      box.addEventListener("drop", async (e) => {
        e.preventDefault();
        e.stopPropagation();
        box.classList.remove("drag-over");
        const file = e.dataTransfer.files[0];
        if (file && file.type.startsWith("image/")) {
          await updateRoomImage(index, file);
        }
      });

      // 2. Hidden file input handler
      const fileInput = box.querySelector(".room-file-input");
      fileInput.addEventListener("change", async (e) => {
        const file = e.target.files[0];
        if (file) {
          await updateRoomImage(index, file);
        }
      });

      // 3. Click camera button to change image
      const uploadBtn = box.querySelector(".img-upload-btn");
      uploadBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        fileInput.click();
      });

      // 4. Click image directly to change image
      const imgEl = box.querySelector(".room-img");
      if (imgEl) {
        imgEl.addEventListener("click", (e) => {
          e.stopPropagation();
          fileInput.click();
        });
      }

      // 5. ContentEditable label handlers
      const labelEls = box.querySelectorAll(".room-label[contenteditable='true']");
      labelEls.forEach(labelEl => {
        labelEl.addEventListener("click", (e) => e.stopPropagation());
        labelEl.addEventListener("keydown", (e) => {
          if (e.key === "Enter") {
            e.preventDefault();
            labelEl.blur();
          }
        });
        labelEl.addEventListener("blur", async () => {
          const newName = labelEl.innerText.trim() || DEFAULT_PLACES[index].name;
          labelEl.innerText = newName;
          places[index].name = newName;
          await MapStorage.savePlace(places[index]);
        });
      });

      // 6. Click elsewhere on card to enter room
      box.addEventListener("click", () => enterRoom(index));

      roomsGridEl.appendChild(box);
    });
  }

  async function updateRoomImage(index, file) {
    try {
      const compressed = await compressImage(file);
      places[index].image = compressed;
      await MapStorage.savePlace(places[index]);
      const img = document.querySelector(`#room_${index} .room-img`);
      if (img) img.src = compressed;
    } catch(err) {
      console.error("Image update failed:", err);
    }
  }

  function setLine(id, x1, y1, x2, y2) {
    const el = document.getElementById(id);
    if (!el) return;
    el.setAttribute("x1", x1);
    el.setAttribute("y1", y1);
    el.setAttribute("x2", x2);
    el.setAttribute("y2", y2);
  }

  function updateStreetLines(layoutRect, colXMap, rowYMap, b0, b3, b8) {
    const topY = b0.top - layoutRect.top;
    const bottomY = rowYMap[4];
    const rightEdge = b3.right - layoutRect.left;
    const leftBoardEdge = b0.left - layoutRect.left;

    // Vertical dashed street centerlines
    setLine("vLine1", colXMap[1], topY, colXMap[1], bottomY);
    setLine("vLine2", colXMap[3], topY, colXMap[3], bottomY);
    setLine("vLine3", colXMap[5], topY, colXMap[5], bottomY);

    // Horizontal dashed street centerlines
    setLine("hLine1", leftBoardEdge, rowYMap[0], rightEdge, rowYMap[0]);
    setLine("hLine2", leftBoardEdge, rowYMap[2], rightEdge, rowYMap[2]);

    // Bottom street: starts at left board edge where the bottom street begins
    setLine("hLine3", leftBoardEdge, bottomY, rightEdge, bottomY);
  }

  function updateMoverVisual() {
    const appLayout = document.getElementById("appLayout");
    const layoutRect = appLayout ? appLayout.getBoundingClientRect() : { left: 0, top: 0, width: window.innerWidth, height: window.innerHeight };

    const r0 = document.getElementById("room_0");
    const r1 = document.getElementById("room_1");
    const r2 = document.getElementById("room_2");
    const r3 = document.getElementById("room_3");
    const r4 = document.getElementById("room_4");
    const r8 = document.getElementById("room_8");

    if (!r0 || !r1 || !r2 || !r3 || !r4 || !r8) return;

    const b0 = r0.getBoundingClientRect();
    const b1 = r1.getBoundingClientRect();
    const b2 = r2.getBoundingClientRect();
    const b3 = r3.getBoundingClientRect();
    const b4 = r4.getBoundingClientRect();
    const b8 = r8.getBoundingClientRect();

    // 7 column positions relative to layout
    const colXMap = [
      (b0.left + b0.width / 2) - layoutRect.left,
      ((b0.right + b1.left) / 2) - layoutRect.left,
      (b1.left + b1.width / 2) - layoutRect.left,
      ((b1.right + b2.left) / 2) - layoutRect.left,
      (b2.left + b2.width / 2) - layoutRect.left,
      ((b2.right + b3.left) / 2) - layoutRect.left,
      (b3.left + b3.width / 2) - layoutRect.left
    ];

    // 5 row positions relative to layout
    const streetH1 = ((b0.bottom + b4.top) / 2) - layoutRect.top;
    const streetH2 = ((b4.bottom + b8.top) / 2) - layoutRect.top;
    const bottomStreetY = (b8.bottom - layoutRect.top) + 10;

    const rowYMap = [
      streetH1,
      ((b4.top + b4.height / 2) - layoutRect.top),
      streetH2,
      ((b8.top + b8.height / 2) - layoutRect.top),
      bottomStreetY
    ];

    let colX = 0;
    let rowY = 0;

    if (moverPosition === 38 || moverPosition === "start") {
      const sideControls = document.querySelector(".side-controls");
      const sideRect = sideControls ? sideControls.getBoundingClientRect() : { left: 0, width: 105 };
      colX = (sideRect.left - layoutRect.left) + sideRect.width / 2;
      rowY = bottomStreetY;
    } else {
      const col = moverPosition % 7;
      const row = Math.floor(moverPosition / 7);
      colX = colXMap[col];
      rowY = rowYMap[row];
    }

    moverAvatarEl.style.left = `${colX}px`;
    moverAvatarEl.style.top = `${rowY}px`;
    moverImgEl.style.transform = `rotate(${moverAngle}deg)`;

    updateStreetLines(layoutRect, colXMap, rowYMap, b0, b3, b8);
  }

  /* ==========================================================================
     5. MOVEMENT CONTROLS
     ========================================================================== */
  function turnLeft() {
    moverAngle -= 90;
    updateMoverVisual();
  }

  function turnRight() {
    moverAngle += 90;
    updateMoverVisual();
  }

  let walkTimer = null;
  function stepWalk(duration = 350, steps = 4) {
    if (walkTimer) clearInterval(walkTimer);
    let count = 0;
    const interval = Math.floor(duration / steps);
    walkTimer = setInterval(() => {
      stepToggle = !stepToggle;
      moverImgEl.src = stepToggle ? personSvg2 : personSvg1;
      count++;
      if (count >= steps) {
        clearInterval(walkTimer);
        walkTimer = null;
      }
    }, interval);
  }

  function goStraight() {
    const moverDir = getMoverDir();
    if (moverPosition === 38 || moverPosition === "start") {
      if (moverDir === "east") {
        moverPosition = 28;
        stepWalk();
        updateMoverVisual();
      }
      return;
    }

    if (moverDir === "north") {
      if (entryObj[moverPosition] !== undefined) {
        enterRoom(entryObj[moverPosition]);
        return;
      }
      if (moverPosition - 14 >= 0 && canMoveCells.has(moverPosition - 14)) {
        moverPosition -= 14;
        stepWalk();
        updateMoverVisual();
        return;
      }
    } else if (moverDir === "south") {
      if (moverPosition + 14 < 35 && canMoveCells.has(moverPosition + 14) && entryObj[moverPosition] === undefined) {
        moverPosition += 14;
        stepWalk();
        updateMoverVisual();
        return;
      }
    } else if (moverDir === "east") {
      if (moverPosition % 7 < 6 && canMoveCells.has(moverPosition + 1)) {
        moverPosition += 1;
        stepWalk();
        updateMoverVisual();
        return;
      }
    } else if (moverDir === "west") {
      if (moverPosition === 28) {
        moverPosition = 38;
        stepWalk();
        updateMoverVisual();
        return;
      }
      if (moverPosition % 7 > 0 && canMoveCells.has(moverPosition - 1)) {
        moverPosition -= 1;
        stepWalk();
        updateMoverVisual();
        return;
      }
    }
  }

  function reset() {
    if (walkTimer) {
      clearInterval(walkTimer);
      walkTimer = null;
    }
    moverPosition = 38;
    moverAngle = 90;
    stepToggle = false;
    moverImgEl.src = personSvg1;
    updateMoverVisual();

    // Flip everything back and reset mode state
    document.querySelectorAll(".room-box").forEach(box => box.classList.remove("is-flipped", "highlight"));
    if (currentMode === "secret") {
      revealedSecrets.clear();
      renderRooms();
    } else if (currentMode === "treasure") {
      treasureIndex = Math.floor(Math.random() * 12);
      renderRooms();
    }
  }

  function enterRoom(index) {
    const place = places[index];
    const box = document.getElementById(`room_${index}`);
    if (!place || !box) return;

    if (currentMode === "practice") {
      box.classList.add("highlight");
      speak(place.name);
      setTimeout(() => box.classList.remove("highlight"), 1800);
    } else if (currentMode === "treasure") {
      box.classList.add("is-flipped");
      if (index === treasureIndex) {
        speak(`You found the star at the ${place.name}!`);
      } else {
        speak(place.name);
        setTimeout(() => box.classList.remove("is-flipped"), 2200);
      }
    } else if (currentMode === "secret") {
      box.classList.add("is-flipped");
      revealedSecrets.add(index);
      speak(`Number ${index + 1} is the ${place.name}!`);
    }
  }

  function setMode(mode) {
    currentMode = mode;
    $("#modePractice, #modeTreasure, #modeSecret").removeClass("btn-primary").addClass("btn-outline-primary");
    if (mode === "practice") $("#modePractice").removeClass("btn-outline-primary").addClass("btn-primary");
    if (mode === "treasure") {
      $("#modeTreasure").removeClass("btn-outline-primary").addClass("btn-primary");
      treasureIndex = Math.floor(Math.random() * 12);
    }
    if (mode === "secret") {
      $("#modeSecret").removeClass("btn-outline-primary").addClass("btn-primary");
      revealedSecrets.clear();
      places.sort(() => 0.5 - Math.random());
    }
    renderRooms();
    reset();
  }

  /* ==========================================================================
     6. SPEECH RECOGNITION (From Snake Activity)
     ========================================================================== */
  const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
  const SpeechGrammarList = window.SpeechGrammarList || window.webkitSpeechGrammarList;

  if (!SpeechRecognition) {
    $("#unsupportedAlert").show();
    $("#listen, #stop").prop("disabled", true);
  }

  const recognition = SpeechRecognition ? new SpeechRecognition() : null;
  const vocab = [
    "turn left", "left", "turn right", "right",
    "go straight", "straight", "forward",
    "go straight two blocks", "straight two blocks", "two blocks",
    "go straight three blocks", "three blocks",
    "restart", "reset", "practice", "treasure", "secret"
  ];

  if (recognition) {
    if (SpeechGrammarList) {
      try {
        const grammar = `#JSGF V1.0; grammar commands; public <commands> = ${vocab.join(" | ")};`;
        const speechRecognitionList = new SpeechGrammarList();
        speechRecognitionList.addFromString(grammar, 1);
        recognition.grammars = speechRecognitionList;
      } catch (e) {}
    }
    recognition.continuous = true;
    recognition.interimResults = true;
    recognition.lang = "en-US";
    recognition.maxAlternatives = 1;
  }

  let isListening = false;
  let lastCommandTime = 0;
  const processedResults = {};

  const commandPatterns = [
    { regex: /\b(restart|reset|start over)\b/i, action: () => reset() },
    { regex: /\b(go straight (three|3) blocks|(three|3) blocks)\b/i, action: () => { goStraight(); setTimeout(goStraight, 370); setTimeout(goStraight, 740); } },
    { regex: /\b(go straight (two|2) blocks|(two|2) blocks|straight two)\b/i, action: () => { goStraight(); setTimeout(goStraight, 370); } },
    { regex: /\b(go straight|straight|strait|forward|ahead)\b/i, action: () => goStraight() },
    { regex: /\b(turn left|left)\b/i, action: () => turnLeft() },
    { regex: /\b(turn right|right|write)\b/i, action: () => turnRight() },
    { regex: /\b(practice)\b/i, action: () => setMode('practice') },
    { regex: /\b(treasure)\b/i, action: () => setMode('treasure') },
    { regex: /\b(secret)\b/i, action: () => setMode('secret') }
  ];

  function startListening() {
    if (!recognition) return;
    isListening = true;
    lastCommandTime = 0;
    for (let k in processedResults) delete processedResults[k];
    try { recognition.start(); } catch(e) {}
    $("#listen").addClass("mic-listening btn-success").prop("disabled", true);
    $("#stop").prop("disabled", false).addClass("btn-danger").removeClass("btn-secondary");
    $("#speechTranscript").text("Listening...").removeClass("text-danger").addClass("text-muted");
  }

  function stopListening() {
    if (!recognition) return;
    isListening = false;
    try { recognition.stop(); } catch(e) {}
    $("#listen").removeClass("mic-listening").prop("disabled", false);
    $("#stop").prop("disabled", true).removeClass("btn-danger").addClass("btn-secondary");
    $("#speechTranscript").text("Voice controls stopped.");
  }

  if (recognition) {
    recognition.onresult = (event) => {
      for (let i = event.resultIndex; i < event.results.length; ++i) {
        const res = event.results[i];
        const text = res[0].transcript.toLowerCase().trim();
        if (text) $("#speechTranscript").text(`Heard: "${text}"`);
        if (processedResults[i]) continue;

        const now = Date.now();
        if (now - lastCommandTime < 260) continue;

        let matched = false;
        for (const cmd of commandPatterns) {
          if (cmd.regex.test(text)) {
            cmd.action();
            matched = true;
            break;
          }
        }
        if (matched) {
          lastCommandTime = Date.now();
          processedResults[i] = true;
          if (i > 10) delete processedResults[i - 10];
        }
      }
    };

    recognition.onend = () => {
      if (isListening) {
        setTimeout(() => {
          if (isListening) {
            try { recognition.start(); } catch(e) {}
          }
        }, 200);
      } else {
        stopListening();
      }
    };

    recognition.onerror = (e) => {
      if (e.error === "not-allowed") {
        stopListening();
        $("#speechTranscript").text("Microphone access denied.").addClass("text-danger");
      }
    };
  }

  /* ==========================================================================
     7. SETUP & INITIALIZATION
     ========================================================================== */
  async function init() {
    await MapStorage.init();
    const saved = await MapStorage.getAllPlaces();
    if (saved && saved.length > 0) {
      saved.forEach(item => {
        if (typeof item.id === "number" && item.id < 12) {
          places[item.id] = { ...places[item.id], ...item };
        }
      });
    }

    renderRooms();
    updateMoverVisual();

    window.addEventListener("resize", updateMoverVisual);
    window.addEventListener("load", updateMoverVisual);

    // Controls
    $("#listen").on("click", startListening);
    $("#stop").on("click", stopListening);
    $("#resetBtn").on("click", reset);

    $("#modePractice").on("click", () => setMode("practice"));
    $("#modeTreasure").on("click", () => setMode("treasure"));
    $("#modeSecret").on("click", () => setMode("secret"));

    // Keyboard controls
    $(document).on("keydown", (e) => {
      if ($(e.target).is("input, textarea, [contenteditable='true']")) return;
      if (e.key === "ArrowUp" || e.key === "w" || e.key === "W") {
        e.preventDefault();
        goStraight();
      } else if (e.key === "ArrowLeft" || e.key === "a" || e.key === "A") {
        e.preventDefault();
        turnLeft();
      } else if (e.key === "ArrowRight" || e.key === "d" || e.key === "D") {
        e.preventDefault();
        turnRight();
      } else if (e.key === "r" || e.key === "R") {
        e.preventDefault();
        reset();
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
</script>

