<!--
  lobby/lobby.ejs — Multiplayer lobby + activity loader
  ════════════════════════════════════════════════════════════════════════
  This view handles:
    1. Player identity (name, color, pawn SVG) persisted in localStorage
    2. Room management (create private, search & join public)
    3. Activity selection + dynamic loading via $.load()
    4. Socket.IO events for real-time multiplayer state

  Server-rendered data:
    • `activities` array — list of available multiplayer activities (id, label)
    • `__('pleaseSelect')` — i18n string

  AUDIT STATUS / RESOLUTION:
    • XSS (`updatePlayerList` & `roomSearch`): Resolved. Player IDs are sanitized
      using comprehensive HTML escaping (`escapeHtml()`) and colors are strictly
      validated as hex formats via `sanitizeColor()`.
    • XSS / SVG Injection (`getPawn`): Resolved. Color values are validated with
      strict hex regex in `sanitizeColor()`, preventing attribute breakout.
    • Activity Validation (`loadActivity`): Resolved. Activity IDs are validated
      against the configured activities whitelist both client-side and in Socket.IO handlers.
    • Modern JS: Resolved. Upgraded older `var` usage to `let`/`const` throughout
      lobby and socket controllers.
    • Listener Cleanup: `getName()` promise correctly removes socket listeners to prevent leaks.
-->
<%- include('../head') -%>

<style>
  .activity .pawn {
    width: 32px;
    height: 16px;
    display: inline-block;
  }

  .activity .host-pawn {
    width: 24px;
    height: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .activity .host-pawn .pawn {
    width: 24px;
    height: 16px;
  }

  #activityExit {
    width: 48px;
    height: 48px;
    padding: 0;
  }

  #roomSearch:focus::placeholder {
    color: transparent;
  }

  #roomSearch:focus::-webkit-input-placeholder {
    color: transparent;
  }

  #roomSearch:focus::-moz-placeholder {
    color: transparent;
  }

  #roomSearch:focus:-ms-input-placeholder {
    color: transparent;
  }
</style>


<div id="menu-container" class="d-flex">
  <div id="studentSideMenu">
    <% if (typeof isTeacher !== 'undefined' && isTeacher) { %>
      <%- include('../teachers/navbar') -%>
    <% } else { %>
      <%- include('../students/navbar') -%>
    <% } %>
  </div>

  <div class="container-fluid">
    <div class="row">
      <div id="lobbyColumn" class="col-sm-4 mb-3">

  <!-- MY GROUP -->
        <div id="myGroup" class="container alert-primary border border-primary rounded-3 px-3 pb-3 my-3">
          <div class="row">

            <div class="col-3">
              Group:
            </div>

            <div class="col-9 display-1 YM" style="margin-top:-15px;margin-bottom:5px;">
              <div id="roomname"></div>
            </div>

          </div>
          <div class="row bg-light border border-primary rounded-3">

            <div class="col-2">
              <div id="myPawn" class="my-1 text-center" style="margin:auto;width:32px;"></div>
            </div>

            <div class="col-10">
              <div class="d-flex align-items-center justify-content-between">
                <div id="myName" class="fs-3 text-break" style="text-shadow:0px 0px 2px #555"></div>
                <span id="hostBadge" class="small badge bg-warning text-dark d-none px-1" style="font-size: 0.75rem;" title="You are the Table Host" aria-label="Table Host">
                  Host
                </span>
              </div>
              <div class="d-flex justify-content-between mb-1">
                <button id="getName" class="btn btn-sm btn-outline-primary px-1 py-0 d-none">Change Name</button>
                <input id="color" class="form-control form-control-sm p-0 mx-1" type="color" aria-label="Player color picker" title="Choose your player color">
              </div>
            </div>

          </div>
          <div id="otherPlayers"></div><!-- rows for other players will be added dynamically here -->

          <div class="row" id="leaveGroup" style="display: none;">
            <div class="col d-flex px-0">
              <img src="/image/exit.svg" alt="leave group" class="img-fluid point" style="width: 64px; height: 64px;" title="Leave Group">
              <div id="info" class="ms-2 align-self-center"></div>
            </div>
          </div>
  
        </div> <!-- end of myGroup -->


  <!-- FRIEND'S GROUP -->
        <div id="group" class="container alert-success text-center border border-success rounded-3 p-3" style="display: none;">
          <div class="row">

            <div class="col-12 g-0">
              <div id="foundplayers" class="text-success mb-3">
                <!-- player names only will be added dynamically here -->
              </div>
              <form id="roomSearchForm" class="form d-flex">
                <button id="join" class="btn btn-success" disabled title="Join group" aria-label="Join group">
                  <i class="material-icons fs-1">groups</i>
                </button>
                <input id="roomSearch" class="form-control fs-1 text-success text-center" placeholder="join" aria-label="Room search input" title="Enter room name to search" autocomplete="off" autocorrect="off" autocapitalize="none" spellcheck="false">

              </form>
            </div>

          </div>

          <div id="publicRoomsContainer" class="row mt-3" style="display: none;">
            <div class="col-12 g-0">
              <hr class="my-2 border-success opacity-50">
              <div class="small fw-bold text-success mb-2">Public Groups</div>
              <div id="publicRoomsList" class="d-flex flex-column gap-2">
                <!-- Public room buttons dynamically rendered here -->
              </div>
            </div>
          </div>
        </div> <!-- end of friend's group -->

      </div> 

      <div id="activityColumn" class="col-sm-8">
        <div id="activityHeader" class="d-flex justify-content-between align-items-center">
          <!-- Left: Host Badge & Room Name -->
          <div class="d-flex align-items-center">
            <div id="activityExit" class="d-none me-2 point" title="Leave activity" aria-label="Leave activity">
              <img src="/image/exit.svg" class="h-100 w-100"></i>
            </div>
            <span id="activityRoomName" class="fs-2 fw-bold text-success"></span>&nbsp;
            <span id="activityHostBadge" class="badge bg-warning text-dark d-none px-1 mb-3" style="font-size: 0.6rem;" title="You are the Table Host" aria-label="Table Host">
              H
            </span>
          </div>

          <!-- Middle: User Instructions / Status -->
          <div id="activityStatus" class="fs-5 fw-bold text-secondary text-center flex-grow-1 mx-2 text-truncate"></div>

          <!-- Right: Host Controls & Exit Button -->
          <div class="d-flex align-items-center gap-2 flex-shrink-0 ms-auto">
            <div id="activityControls" class="d-flex align-items-center gap-2"></div>
          </div>
        </div>

        <div id="activityMenu">
          <div id="standardActivities" style="display:none;"> <!-- UNCOMMENT WHEN THESE ACTIVITIES ARE READY -->
            <% activities.filter(a => a.group !== 'host').forEach(function(activity){ %>
              <button class="btn btn-outline-primary activity d-flex justify-content-between align-items-center w-100 mb-2" id="<%= activity.id %>" data-group="standard" title="<%= activity.label %> activity" aria-label="<%= activity.label %> activity">
                <span class="activity-left d-flex align-items-center gap-2">
                  <span class="host-pawn"></span>
                  <span class="activity-label"><%= activity.label %></span>
                </span>
                <span class="activity-pawns d-flex align-items-center"></span>
              </button>
            <% }); %>
            <hr />
          </div>
          
          <div id="hostActivities" class="d-none">
            <div id="hostActivitiesHeader" class="small text-muted fw-bold mb-2">Host Activities</div>
            <% activities.filter(a => a.group === 'host').forEach(function(activity){ %>
              <div class="rounded-3 border border-primary mb-2 host-activity-row" id="row-<%= activity.id %>">

                <div class="btn activity d-flex justify-content-between align-items-center flex-grow-1 pe-2" 
                        id="<%= activity.id %>" data-group="host" title="<%= activity.label %> activity" aria-label="<%= activity.label %> activity">
                  <span class="activity-label">
                    <%= activity.label %>
                  </span>
                  <span class="activity-pawns d-flex align-items-center"></span>
                  <div>
                    <span class="activity-count badge bg-secondary ms-1">0</span>
                    <button class="btn btn-sm btn-success start-activity-btn d-none" data-activity="<%= activity.id %>" 
                          title="Start <%= activity.label %>" aria-label="Start <%= activity.label %>">
                      Start
                    </button>
                  </div>
                </div>


                <% if (activity.id === 'popquiz') { %>
                  <div id="popquiz-config" class="d-none">
                    <textarea id="popquiz-questions" class="form-control form-control-sm font-monospace rounded-3" rows="4" 
                              placeholder="Put answers to multiple-choice questions here separated by commas.&#10;apples, bananas, pears&#10;red, yellow, green, blue&#10;..."></textarea>
                  </div>
                <% } %>
                <% if (activity.id === 'raffle') { %>
                  <div id="raffle-config" class="d-none">
                    <textarea id="raffle-values" class="form-control form-control-sm font-monospace rounded-3" rows="3" 
                              placeholder="Enter comma-separated values.&#10;a New Car, Steak Knives, Detergent, a Trip to Cancun ..."></textarea>
                  </div>
                <% } %>
                <% if (activity.id === 'vote') { %>
                  <div id="vote-config" class="d-none">
                    <textarea id="vote-values" class="form-control form-control-sm font-monospace rounded-3" rows="3" 
                              placeholder="Enter comma-separated options to vote on.&#10;Elephants, Donkeys, Panthers ..."></textarea>
                  </div>
                <% } %>


              </div>
            <% }); %>
          </div>
        </div>

        <div id="activityContent" class="mt-2"></div>
      </div>

      <div id="sideColumn" class="col-sm-4">
        <%//- include('../menu/select_NH') %>
      </div>

    </div>
  </div>

</div>

<script id="activitiesConfigData" type="application/json"><%- JSON.stringify(activities) %></script>
<script id="multiplayerI18nData" type="application/json"><%- JSON.stringify({ pleaseSelect: __('pleaseSelect') }) %></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.socket.io/4.0.1/socket.io.js"></script>
<script src="https://cdn.jsdelivr.net/gh/bevacqua/dragula@3.7.3/dist/dragula.min.js"></script>
<script src="/javascripts/lobby/hosted/common.js"></script>
<% activities.forEach(function(activity){ %>
  <script src="/javascripts/lobby/<%= activity.group === 'host' ? 'hosted' : 'multiplayer' %>/<%= activity.id %>.js"></script>
<% }); %>
<script src="/javascripts/lobby/lobby.js"></script>
<script>
  $(document).ready(function() {
    $('#lobby-tab').addClass('active');
  });
</script>

<%- include('../foot') -%>
