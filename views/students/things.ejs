<!--
  students/things.ejs — "Things" activity menu page
  ══════════════════════════════════════════════════
  Activities: Multi-Touch Shapes, Say Colors (speech), School Supplies,
  Bedroom, Dressup (boy/girl).
  Pure menu page — no game logic, just links and decorative previews.
-->
<%- include('../head') -%>

  <div id="menu-container" class="d-flex">
    <%- include('navbar') -%>

      <div class="container-fluid mt-3">
        <div class="row">

          <div class="col-sm">
            <a href="things/shapes" class="btn mb-1 border border-3 border-primary shadow w-100 YM"
              style="height: calc(50% - 0.25rem);">
              <h5>Multi-Touch Shapes</h5>
              <div class="d-flex justify-content-around">
                <div class="shape" data-shape="circle">
                  <svg class="circle-svg" width="100%" height="100%" viewBox="0 0 100 100" fill="none"
                    xmlns="http://www.w3.org/2000/svg">
                    <circle cx="50" cy="50" r="45" fill="red" />
                  </svg>
                </div>
                <div class="shape" data-shape="square">
                  <svg class="square-svg" width="100%" height="100%" viewBox="0 0 100 100" fill="none"
                    xmlns="http://www.w3.org/2000/svg">
                    <rect x="10" y="10" width="80" height="80" fill="blue" />
                  </svg>
                </div>
                <div class="shape" data-shape="triangle">
                  <svg class="triangle-svg" width="100%" height="100%" viewBox="0 0 100 100" fill="none"
                    xmlns="http://www.w3.org/2000/svg">
                    <polygon points="50,5 95,95 5,95" fill="green" />
                  </svg>
                </div>
                <div class="shape" data-shape="rectangle">
                  <svg class="rectangle-svg" width="100%" height="100%" viewBox="0 0 100 100" fill="none"
                    xmlns="http://www.w3.org/2000/svg">
                    <rect x="10" y="20" width="80" height="60" fill="yellow" />
                  </svg>
                </div>
              </div>
            </a>

            <a href="things/colors" class="btn mb-1 border border-3 border-primary shadow w-100 YM"
              style="height: calc(50% - 0.25rem); overflow: hidden;">
              <div class="container text-center h-100 g-0">
                <h5>Say Colors</h5>
                <div class="row g-0">
                  <div class="col pt-3 bg-danger w-25 text-center">
                    <i class="material-icons text-white" style="font-size:4rem;">
                      record_voice_over
                    </i>
                  </div>
                  <div class="col pt-3 bg-warning w-25">
                    <i class="material-icons text-white" style="font-size:4rem;">
                      record_voice_over
                    </i>
                  </div>
                  <div class="col pt-3 bg-success w-25">
                    <i class="material-icons text-white" style="font-size:4rem;">
                      record_voice_over
                    </i>
                  </div>
                  <div class="col pt-3 bg-primary w-25">
                    <i class="material-icons text-white" style="font-size:4rem;">
                      record_voice_over
                    </i>
                  </div>
                </div>
              </div>
            </a>
          </div>

          <div class="col-sm mb-1">
            <a href="things/supplies" class="btn mb-1 border border-3 border-primary shadow w-100 YM"
              style="height: calc(50% - 0.25rem);">
              <h5>School Supplies</h5>
              <div class="d-flex justify-content-around">
                <img src="/image/colorable/stapler.svg" class="img-fluid" style="width:20%;" alt="Stapler">
                <img src="/image/colorable/pencilcase.svg" class="img-fluid" style="width:20%;" alt="Pencilcase">
                <img src="/image/colorable/scissors.svg" class="img-fluid" style="width:20%;" alt="Scissors">
              </div>
            </a>

            <a href="things/room" class="btn mb-1 border border-3 border-primary shadow w-100 YM"
              style="height: calc(50% - 0.25rem); background-image: url('/image/room.svg');background-size:cover; background-position: bottom;">
              <h5>Bedroom</h5>
              <div class="d-flex justify-content-around">
                <img src="/image/objects/book.svg" class="img-fluid" style="width:20%;" alt="Book">
                <img src="/image/objects/dog.svg" class="img-fluid" style="width:20%;" alt="Dog">
                <img src="/image/objects/ball.svg" class="img-fluid" style="width:20%;" alt="Ball">
              </div>
            </a>
          </div>


          <div class="col-sm-2 mb-1" style="height:300px;">
            <a href="things/dressup/boy"
              class="btn mb-1 position-relative border-3 border-primary shadow w-100 YM"
              style="height: calc(100% - 0.25rem); overflow:hidden;">
              <h5>Dressup</h5>
              <img src="/image/dressup/boy/_boy.png" class="img-fluid" style="position:absolute;left:0;top:0;"
                alt="Boy">
              <img src="/image/dressup/boy/dog_T-shirt.png" class="img-fluid" style="position:absolute;left:0;top:0;"
                alt="Dog T-shirt">
              <img src="/image/dressup/boy/cargo_shorts.png" class="img-fluid" style="position:absolute;left:0;top:0;"
                alt="Cargo_shorts">
            </a>
          </div>

          <div class="col-sm-2 mb-1" style="height:300px;">
            <a href="things/dressup/girl"
              class="btn mb-1 position-relative border-3 border-primary shadow w-100 YM"
              style="height: calc(100% - 0.25rem); overflow:hidden;">
              <h5>Dressup</h5>
              <img src="/image/dressup/girl/_girl.png" class="img-fluid" style="position:absolute;left:0;top:0;"
                alt="Girl">
              <img src="/image/dressup/girl/dress.png" class="img-fluid" style="position:absolute;left:0;top:0;"
                alt="Dress">
              <img src="/image/dressup/girl/sunglasses.png" class="img-fluid" style="position:absolute;left:0;top:0;"
                alt="Sunglasses">
            </a>
          </div>

        </div>
        <div class="row">
          <div class="col-sm mb-1">
            <a href="/things/snake" class="btn mbj-1 border border-3 border-primary shadow w-100 YM">
              <h5 class=""card-title">Snake</h5>
              <img src="/image/svg/snake.svg" class="img-fluid" style="height:100px;" alt="Snake">
            </a>
          </div>
          <div class="col-sm mb-1">
            <a href="/things/map"
              class="btn mb-1 border border-3 border-primary shadow w-100 h-100 text-center YM">
              <h5 class="card-title">Getting Around</h5>
              <img src="/image/map.png" class="img-fluid" style="height:100px;" alt="Getting Around">
            </a>
          </div>
          <div class="col-sm"></div>
        </div>
      </div>

  </div>


  <script>
    $(function () {
      $(`#things-tab`).addClass("active");
    });
  </script>

  <%- include('../foot') -%>